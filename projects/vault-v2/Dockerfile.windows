# Multi-stage Dockerfile for building Windows .exe with Tauri
FROM rust:1.75-bullseye as builder

# Install dependencies for cross-compilation
RUN apt-get update && apt-get install -y \
    # Basic build tools
    build-essential \
    curl \
    wget \
    file \
    # Libraries for Tauri
    libwebkit2gtk-4.0-dev \
    libssl-dev \
    libgtk-3-dev \
    libayatana-appindicator3-dev \
    librsvg2-dev \
    # Windows cross-compilation tools
    gcc-mingw-w64-x86-64 \
    g++-mingw-w64-x86-64 \
    mingw-w64 \
    # Node.js for frontend build
    && curl -fsSL https://deb.nodesource.com/setup_20.x | bash - \
    && apt-get install -y nodejs \
    # Install bun
    && npm install -g bun \
    # Install wine for Windows builds (optional, for testing)
    && dpkg --add-architecture i386 \
    && apt-get update \
    && apt-get install -y wine wine32 wine64 \
    # Clean up
    && rm -rf /var/lib/apt/lists/*

# Add Windows target for Rust
RUN rustup target add x86_64-pc-windows-gnu

# Set up cargo config for cross-compilation
RUN mkdir -p /usr/local/cargo/config
RUN echo '[target.x86_64-pc-windows-gnu]' >> /usr/local/cargo/config/config.toml && \
    echo 'linker = "x86_64-w64-mingw32-gcc"' >> /usr/local/cargo/config/config.toml && \
    echo 'ar = "x86_64-w64-mingw32-ar"' >> /usr/local/cargo/config/config.toml

# Set working directory
WORKDIR /app

# Copy the entire project structure (we need keepkey-rust dependency)
COPY . /workspace

# Set the working directory to vault-v2
WORKDIR /workspace/projects/vault-v2

# Install frontend dependencies and build
RUN bun install
RUN bun run build

# Build the Rust application for Windows
WORKDIR /workspace/projects/vault-v2/src-tauri

# Set environment variables for cross-compilation
ENV CC_x86_64_pc_windows_gnu=x86_64-w64-mingw32-gcc \
    CXX_x86_64_pc_windows_gnu=x86_64-w64-mingw32-g++ \
    AR_x86_64_pc_windows_gnu=x86_64-w64-mingw32-ar \
    CARGO_TARGET_X86_64_PC_WINDOWS_GNU_LINKER=x86_64-w64-mingw32-gcc \
    PKG_CONFIG_ALLOW_CROSS=1

# Build the application
RUN cargo build --release --target x86_64-pc-windows-gnu

# Install tauri-cli
RUN cargo install tauri-cli

# Build with Tauri (creates the .exe installer)
RUN cargo tauri build --target x86_64-pc-windows-gnu

# Final stage - extract the built executable
FROM debian:bullseye-slim

# Install wine for testing (optional)
RUN dpkg --add-architecture i386 && \
    apt-get update && \
    apt-get install -y wine wine32 wine64 && \
    rm -rf /var/lib/apt/lists/*

# Copy the built executables from builder
COPY --from=builder /workspace/projects/vault-v2/src-tauri/target/x86_64-pc-windows-gnu/release/*.exe /output/
COPY --from=builder /workspace/projects/vault-v2/src-tauri/target/release/bundle/nsis/*.exe /output/installer/ 2>/dev/null || true
COPY --from=builder /workspace/projects/vault-v2/src-tauri/target/release/bundle/msi/*.msi /output/installer/ 2>/dev/null || true

WORKDIR /output

# Default command to list built files
CMD ["ls", "-la", "/output/"]